# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and is sourced automatically by ralph.sh.

# Discord webhook URL for per-iteration notifications.
# Create one in your Discord channel: Settings -> Integrations -> Webhooks.
# Leave empty (or unset) to disable Discord notifications.
RALPH_DISCORD_WEBHOOK=

# ── Guardrails (all optional; defaults preserve historical behavior) ──

# Cumulative cost cap in cents across all usage-*.json in the log dir
# (i.e. lifetime of ralph-logs/, across runs). Loop aborts with exit 2
# when spend reaches the cap. Empty or 0 = unlimited.
RALPH_MAX_BUDGET_CENTS=

# Per-iteration --max-turns for claude. Default 200; 0 = unlimited
# (restores the historical no-cap behavior).
RALPH_MAX_TURNS=

# Permission handling per iteration:
#   bypass (default)  --dangerously-skip-permissions — safe only inside
#                     the sandbox (docker/sbx modes)
#   acceptEdits|default|plan  passed through as --permission-mode <value>
RALPH_PERMISSION_MODE=
