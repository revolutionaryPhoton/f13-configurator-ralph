# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and is sourced automatically by ralph.sh.

# Discord webhook URL for per-iteration notifications.
# Create one in your Discord channel: Settings -> Integrations -> Webhooks.
# Leave empty (or unset) to disable Discord notifications.
RALPH_DISCORD_WEBHOOK=

# ── Guardrails (all optional; defaults preserve historical behavior) ──

# Cumulative cost cap in cents across all usage-*.json in the log dir
# (i.e. lifetime of ralph-logs/, across runs). Loop aborts with exit 2
# when spend reaches the cap. Empty or 0 = unlimited. Must be a whole
# number of cents — anything else aborts the loop rather than silently
# disabling the cap. Note: the cap is checked between iterations, so a
# single long iteration can overshoot it before the loop stops.
RALPH_MAX_BUDGET_CENTS=

# Per-iteration --max-turns for claude. Default 200; 0 = unlimited
# (restores the historical no-cap behavior).
RALPH_MAX_TURNS=

# Permission handling per iteration:
#   bypass (default)  --dangerously-skip-permissions — safe only inside
#                     the sandbox (docker/sbx modes)
#   acceptEdits|default|plan  passed through as --permission-mode <value>
RALPH_PERMISSION_MODE=

# ── Sandbox (docker mode) ──

# Sandbox image tag. Built by ./ralph.sh --build (or automatically when
# missing) from docker/ralph.Dockerfile.
RALPH_IMAGE=

# claude-code npm version baked into the image at build time. Empty =
# the version pinned in docker/ralph.Dockerfile. Rebuild with --build
# after changing.
RALPH_CLAUDE_CODE_VERSION=

# Container egress firewall: on (default) locks outbound traffic to
# api.anthropic.com + npm + crates.io; off disables the allowlist.
RALPH_FIREWALL=

# Extra domains (space-separated) added to the egress allowlist.
RALPH_NET_ALLOW_EXTRA=

# Override the working directory (default configurator_v1). Mainly for
# throwaway smoke tests — the product loop should not change this.
RALPH_WORKDIR=

# ── Docker Sandboxes (sbx mode) ──

# Opt-in for ralph.sh to initialize the GLOBAL sbx network policy when
# it is not set up yet. This is a one-time, machine-wide decision that
# affects ALL your sbx sandboxes (agent kits still add their own
# per-sandbox allows). Only "deny-all" is honored; leave empty to be
# prompted with instructions instead.
RALPH_SBX_POLICY_INIT=
